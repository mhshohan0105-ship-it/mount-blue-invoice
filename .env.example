# Password you type on the login screen
APP_PASSWORD=change-me-to-a-strong-password

# Random text used to sign the login cookie (make it long).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Neon Postgres connection string. On Vercel this is added automatically when
# you connect a Neon database from the Storage tab. For local dev, copy it from
# Vercel -> Storage -> your database -> .env.local tab (or run `vercel env pull`).
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Optional: shop website used by "Sync from website" (Shopify store)
# SHOP_WEBSITE_URL=https://www.mountblue4u.com

# Future: Steadfast courier API (not used yet)
# STEADFAST_API_KEY=
# STEADFAST_SECRET_KEY=
